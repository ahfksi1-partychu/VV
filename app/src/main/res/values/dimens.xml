<resources>
    <!-- 차량 화면 최소 터치 영역 -->
    <dimen name="touch_target">76dp</dimen>

    <style name="RowButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="SetupButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:minWidth">180dp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textSize">24sp</item>
    </style>
</resources>
