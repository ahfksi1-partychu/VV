<?xml version="1.0" encoding="utf-8"?>
<!-- 설정 › 음성 및 말하기 (VoiceSettingsActivity): 목소리, 말하기 속도, 자동차 블루투스 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phone_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/voice_settings_title"
            android:textColor="@color/phone_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- 목소리 -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/voice_section_voice" />

        <TextView
            android:id="@+id/voiceEngine"
            style="@style/SettingsNote" />

        <RadioGroup
            android:id="@+id/voiceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/voiceMissing"
            style="@style/SettingsNote"
            android:visibility="gone" />

        <Button
            android:id="@+id/voicePreview"
            style="@style/PhoneOutlineButton"
            android:layout_marginTop="10dp"
            android:text="@string/voice_preview" />

        <!-- 말하기 속도 -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/voice_section_rate" />

        <TextView
            android:id="@+id/voiceRateValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/phone_accent"
            android:textSize="28sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/voiceRateSeek"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:progressTint="@color/phone_accent"
            android:thumbTint="@color/phone_accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/voice_rate_min"
                android:textColor="@color/phone_text_hint"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voice_rate_max"
                android:textColor="@color/phone_text_hint"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            style="@style/SettingsNote"
            android:text="@string/voice_rate_note" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/voiceRateReset"
                style="@style/PhoneOutlineButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/voice_rate_reset" />

            <Button
                android:id="@+id/voiceRatePreview"
                style="@style/PhoneOutlineButton"
                android:layout_width="0dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/voice_preview" />
        </LinearLayout>

        <!-- 자동차 블루투스 -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/voice_section_output" />

        <TextView
            android:id="@+id/voiceOutput"
            style="@style/PhoneHintRow"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/voiceInput"
            style="@style/PhoneHintRow"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
