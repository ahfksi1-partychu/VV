<?xml version="1.0" encoding="utf-8"?>
<!--
    폰 테스트용 즐겨찾기 행 (세로 화면). 위 줄: 아이콘·이름, 아래 줄: 순서·별칭·삭제 버튼.
    main/res/layout/item_favorite_app.xml 을 덮어쓴다. id와 뷰 종류는 main과 같아야 한다.
    행 전체 클릭(실행)이 버튼과 함께 동작하도록 하위 포커스를 막는다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/appName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/appDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/moveUp"
            style="@style/RowButton"
            android:contentDescription="@string/move_up"
            android:text="▲" />

        <Button
            android:id="@+id/moveDown"
            style="@style/RowButton"
            android:contentDescription="@string/move_down"
            android:text="▼" />

        <Button
            android:id="@+id/editAlias"
            style="@style/RowButton"
            android:text="@string/alias" />

        <Button
            android:id="@+id/remove"
            style="@style/RowButton"
            android:text="@string/remove" />
    </LinearLayout>
</LinearLayout>
