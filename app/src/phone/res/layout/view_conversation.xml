<?xml version="1.0" encoding="utf-8"?>
<!--
    음성 대화 화면 내용 (PhoneAssistantActivity 전체 화면과 다른 앱 위 창(OverlayAssistantPanel)이 함께 쓴다).
    화면을 보지 않아도 되도록 모든 내용은 음성으로도 말한다. 화면은 자막과 큰 버튼만 보여준다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <FrameLayout
        android:id="@+id/conversationMic"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/phone_mic_circle">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_phone_mic" />
    </FrameLayout>

    <TextView
        android:id="@+id/conversationPhase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/phone_text_secondary"
        android:textSize="15sp" />

    <ProgressBar
        android:id="@+id/conversationLevel"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressTint="@color/phone_listening"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/conversationAssistant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/phone_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/conversationHeard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@color/phone_accent"
        android:textSize="17sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/conversationTextOnly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/conv_text_only"
        android:textColor="@color/phone_text_hint"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- 음성 안내 음량이 0이거나 너무 작을 때만 (ConversationView). 음량은 사용자가 직접 올린다 -->
    <LinearLayout
        android:id="@+id/conversationVolume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/phone_card"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/conversationVolumeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/phone_accent"
            android:textSize="16sp" />

        <Button
            android:id="@+id/conversationVolumeUp"
            style="@style/PhoneAccentButton"
            android:layout_marginTop="10dp"
            android:text="@string/conv_volume_up" />
    </LinearLayout>

    <Button
        android:id="@+id/conversationSend"
        style="@style/PhoneAccentButton"
        android:layout_marginTop="20dp"
        android:text="@string/conv_send"
        android:visibility="gone" />

    <Button
        android:id="@+id/conversationDontSend"
        style="@style/PhoneOutlineButton"
        android:layout_marginTop="8dp"
        android:text="@string/conv_dont_send"
        android:visibility="gone" />

    <Button
        android:id="@+id/conversationAction"
        style="@style/PhoneAccentButton"
        android:layout_marginTop="20dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/conversationAgain"
        style="@style/PhoneAccentButton"
        android:layout_marginTop="20dp"
        android:text="@string/conv_talk_again"
        android:visibility="gone" />

    <Button
        android:id="@+id/conversationStop"
        style="@style/PhoneOutlineButton"
        android:layout_marginTop="8dp"
        android:text="@string/conv_stop" />
</LinearLayout>
