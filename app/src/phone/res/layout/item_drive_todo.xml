<?xml version="1.0" encoding="utf-8"?>
<!-- 할 일 한 줄: 완료 체크, 제목, 기한·장소·출처, [열기] [수정] [삭제] (DriveTodoActivity) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/phone_card"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/todoDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/todoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/phone_text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/todoMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/phone_text_hint"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/todoOpen"
            style="@style/SettingsRowButton"
            android:text="@string/drive_open" />

        <Button
            android:id="@+id/todoEdit"
            style="@style/SettingsRowButton"
            android:text="@string/drive_edit" />

        <Button
            android:id="@+id/todoDelete"
            style="@style/SettingsRowButton"
            android:text="@string/drive_delete" />
    </LinearLayout>
</LinearLayout>
