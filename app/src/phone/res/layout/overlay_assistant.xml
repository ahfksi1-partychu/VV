<?xml version="1.0" encoding="utf-8"?>
<!--
    다른 앱 위에 뜨는 음성비서 창 (폰 테스트용). 글자 입력 없이 상태·알아들은 말·버튼만 보여준다.
    색은 어느 앱 위에서도 읽히도록 어두운 배경에 흰 글자로 고정한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/floating_panel_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlayState"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#FFFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/overlayBusy"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:indeterminate="true"
            android:visibility="gone" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/overlayLevel"
        style="@android:style/Widget.DeviceDefault.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100" />

    <TextView
        android:id="@+id/overlayHeard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/overlayDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="5"
        android:textColor="#DDFFFFFF"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/overlayChoices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/overlayDoneSpeaking"
                style="@style/OverlayButton"
                android:text="@string/assistant_done_speaking" />

            <Button
                android:id="@+id/overlaySkip"
                style="@style/OverlayButton"
                android:text="@string/assistant_skip" />

            <Button
                android:id="@+id/overlaySend"
                style="@style/OverlayButton"
                android:text="@string/assistant_send" />

            <Button
                android:id="@+id/overlayDontSend"
                style="@style/OverlayButton"
                android:text="@string/assistant_dont_send" />

            <Button
                android:id="@+id/overlayRetry"
                style="@style/OverlayButton"
                android:text="@string/assistant_retry" />

            <!-- 권한 허용·알림 접근 등은 대화상자가 필요해 MyCarHub 화면에서 처리 -->
            <Button
                android:id="@+id/overlayOpenApp"
                style="@style/OverlayButton"
                android:text="@string/floating_open_app" />

            <Button
                android:id="@+id/overlayClose"
                style="@style/OverlayButton"
                android:text="@string/assistant_close" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
