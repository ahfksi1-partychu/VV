<?xml version="1.0" encoding="utf-8"?>
<!--
    폰 테스트용 호출어 등록 화면 (세로). main/res/layout/activity_wakeword_setup.xml 을 덮어쓴다.
    id와 뷰 종류는 main과 같아야 한다 (WakeWordSetupActivity가 그대로 사용). 전체 세로 스크롤.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setupDrivingBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#33FFB300"
            android:padding="10dp"
            android:text="@string/setup_blocked_driving"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- 1단계: 이름 입력 -->
        <LinearLayout
            android:id="@+id/namePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_intro"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/nameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/setup_name_hint"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLength="10"
                android:minHeight="@dimen/touch_target"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/nameMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.8"
                android:text="@string/setup_name_rule"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:alpha="0.7"
                android:text="@string/setup_privacy"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/laterButton"
                    style="@style/PortraitButton"
                    android:text="@string/setup_later" />

                <Button
                    android:id="@+id/nextButton"
                    style="@style/PortraitButton"
                    android:text="@string/setup_next" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2단계: 5회 녹음 -->
        <LinearLayout
            android:id="@+id/recordPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/recordInstruction"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/recordProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:alpha="0.75"
                android:text="@string/setup_record_tip"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/recordPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="32dp"
                android:textSize="17sp" />

            <ProgressBar
                android:id="@+id/levelMeter"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginTop="4dp"
                android:max="60" />

            <!-- 녹음 5회 행은 코드가 채운다 (이름 + [다시 녹음]) -->
            <LinearLayout
                android:id="@+id/takesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/cancelButton"
                    style="@style/PortraitButton"
                    android:layout_weight="1"
                    android:text="@string/cancel" />

                <Button
                    android:id="@+id/recordButton"
                    style="@style/PortraitButton"
                    android:layout_weight="2" />
            </LinearLayout>
        </LinearLayout>

        <!-- 3단계: 완료 -->
        <LinearLayout
            android:id="@+id/donePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_done_title"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/doneMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/doneDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.7"
                android:textSize="14sp" />

            <Button
                android:id="@+id/finishButton"
                style="@style/SetupButton"
                android:layout_width="match_parent"
                android:layout_marginStart="0dp"
                android:layout_marginTop="20dp"
                android:text="@string/setup_finish" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
