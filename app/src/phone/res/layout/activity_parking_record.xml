<?xml version="1.0" encoding="utf-8"?>
<!-- 주차 위치 기록 (ParkingRecordActivity): 구역·번호 입력, 사진, 저장 시각·위치·동기화 상태 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phone_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/parking_record_title"
            android:textColor="@color/phone_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- 저장 시각·감지 방식 / 위치 / 동기화 상태 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/phone_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/parkingRecordWhen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/phone_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/parkingRecordPlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/phone_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/parkingRecordSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/phone_text_hint"
                android:textSize="13sp" />

            <Button
                android:id="@+id/parkingRecordMap"
                style="@style/SettingsRowButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginTop="8dp"
                android:text="@string/parking_card_map"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 1. 직접 입력 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/parking_record_note_label"
            android:textColor="@color/phone_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/parkingRecordNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="@string/parking_record_note_hint"
            android:importantForAutofill="no"
            android:inputType="textShortMessage"
            android:maxLength="40"
            android:minHeight="@dimen/touch_target"
            android:textColor="@color/phone_text"
            android:textColorHint="@color/phone_text_hint"
            android:textSize="18sp" />

        <!-- 2. 사진 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/parking_record_photo_label"
            android:textColor="@color/phone_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/parkingRecordPhoto"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/phone_card"
            android:contentDescription="@string/parking_card_photo_desc"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/parkingRecordPhotoNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/parking_record_photo_preview"
            android:textColor="@color/phone_text_hint"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/parkingRecordCamera"
                style="@style/SettingsRowButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="0dp"
                android:text="@string/parking_prompt_photo" />

            <Button
                android:id="@+id/parkingRecordGallery"
                style="@style/SettingsRowButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/parking_record_gallery" />

            <Button
                android:id="@+id/parkingRecordRemovePhoto"
                style="@style/SettingsRowButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/parking_record_remove_photo"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/parking_record_privacy"
            android:textColor="@color/phone_text_hint"
            android:textSize="12sp" />

        <Button
            android:id="@+id/parkingRecordSave"
            style="@style/PhoneAccentButton"
            android:layout_marginTop="20dp"
            android:text="@string/parking_record_save" />

        <Button
            android:id="@+id/parkingRecordLater"
            style="@style/PhoneOutlineButton"
            android:layout_marginTop="10dp"
            android:text="@string/parking_prompt_later" />
    </LinearLayout>
</ScrollView>
