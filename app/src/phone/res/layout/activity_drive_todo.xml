<?xml version="1.0" encoding="utf-8"?>
<!-- Drive To-Do (폰): 마지막 주차 위치, 할 일, 알림에서 찾은 후보, 설정 (DriveTodoActivity) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/phone_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/drive_title"
            android:textColor="@color/phone_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- 마지막 주차 위치 확인하기 (항상 표시) -->
        <LinearLayout
            android:id="@+id/driveParkingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/phone_card"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drive_parking_check"
                android:textColor="@color/phone_accent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/driveParkingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/phone_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/driveParkingMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/phone_text_hint"
                android:textSize="13sp" />

            <!-- 자동 저장 실패·오차 큼 안내 (해당할 때만) -->
            <TextView
                android:id="@+id/driveParkingWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/phone_accent"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- 바로 쓰는 버튼: 지도, 걸어서 길찾기, 지금 위치 저장 (삭제는 카드를 눌러서) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/driveParkingMapButton"
                    style="@style/SettingsRowButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="0dp"
                    android:text="@string/drive_parking_map_short" />

                <Button
                    android:id="@+id/driveParkingWalkButton"
                    style="@style/SettingsRowButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/drive_parking_walk_short" />

                <Button
                    android:id="@+id/driveParkingSaveButton"
                    style="@style/SettingsRowButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/drive_parking_save_short" />
            </LinearLayout>
        </LinearLayout>

        <!-- 차량에 남긴 물건 (사용자가 말한 기록) + 차 찾기 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/driveItemHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/phone_accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/driveFindCarButton"
                style="@style/SettingsRowButton"
                android:text="@string/drive_find_car" />

            <Button
                android:id="@+id/driveItemAddButton"
                style="@style/SettingsRowButton"
                android:text="@string/drive_add" />
        </LinearLayout>

        <TextView
            style="@style/SettingsNote"
            android:text="@string/drive_items_note" />

        <LinearLayout
            android:id="@+id/driveItemList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/driveItemEmpty"
            style="@style/SettingsNote"
            android:text="@string/drive_items_empty" />

        <!-- 하차 후 처리할 일 (차에서 챙길 물건) -->
        <TextView
            android:id="@+id/drivePickupHeader"
            style="@style/SettingsSection" />

        <LinearLayout
            android:id="@+id/drivePickupList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/drivePickupEmpty"
            style="@style/SettingsNote"
            android:text="@string/drive_pickup_empty" />

        <!-- 차량용 앱과의 동기화 상태 + 연결 화면 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/driveSyncStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/phone_text_hint"
                android:textSize="13sp" />

            <Button
                android:id="@+id/driveSyncButton"
                style="@style/SettingsRowButton"
                android:text="@string/sync_title_phone" />
        </LinearLayout>

        <!-- 할 일 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/driveTodoHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/phone_accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/driveAddButton"
                style="@style/SettingsRowButton"
                android:text="@string/drive_add" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/driveTodoList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/driveTodoEmpty"
            style="@style/SettingsNote"
            android:text="@string/drive_todo_empty" />

        <!-- 알림에서 찾은 할 일 후보 -->
        <TextView
            android:id="@+id/driveCandidateHeader"
            style="@style/SettingsSection"
            android:text="@string/drive_candidates" />

        <LinearLayout
            android:id="@+id/driveCandidateList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/driveCandidateNote"
            style="@style/SettingsNote" />

        <!-- 설정 -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/drive_settings" />

        <LinearLayout style="@style/SettingsRow">

            <TextView
                android:id="@+id/driveCarText"
                style="@style/SettingsRowText" />

            <Button
                android:id="@+id/driveCarButton"
                style="@style/SettingsRowButton"
                android:text="@string/phone_change" />
        </LinearLayout>

        <LinearLayout style="@style/SettingsRow">

            <TextView
                android:id="@+id/driveLocationText"
                style="@style/SettingsRowText" />

            <Button
                android:id="@+id/driveLocationButton"
                style="@style/SettingsRowButton"
                android:text="@string/drive_allow" />
        </LinearLayout>

        <LinearLayout style="@style/SettingsRow">

            <TextView
                android:id="@+id/driveNotifyText"
                style="@style/SettingsRowText" />

            <Button
                android:id="@+id/driveNotifyButton"
                style="@style/SettingsRowButton"
                android:text="@string/drive_allow" />
        </LinearLayout>

        <TextView
            style="@style/SettingsNote"
            android:text="@string/drive_detect_note" />

        <Switch
            android:id="@+id/driveAnalyzeSwitch"
            style="@style/SettingsSwitch"
            android:text="@string/drive_analyze" />

        <TextView
            style="@style/SettingsNote"
            android:text="@string/drive_analyze_note" />

        <!-- 장소 -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/drive_places" />

        <LinearLayout
            android:id="@+id/drivePlaceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/drivePlaceAddButton"
            style="@style/PhoneOutlineButton"
            android:layout_marginTop="8dp"
            android:text="@string/drive_place_add" />

        <TextView
            style="@style/SettingsNote"
            android:text="@string/drive_places_note" />

        <!-- 데이터 -->
        <TextView
            style="@style/SettingsSection"
            android:text="@string/drive_data" />

        <Button
            android:id="@+id/driveClearButton"
            style="@style/PhoneOutlineButton"
            android:layout_marginTop="8dp"
            android:text="@string/drive_clear_all" />

        <TextView
            style="@style/SettingsNote"
            android:text="@string/drive_data_note" />
    </LinearLayout>
</ScrollView>
